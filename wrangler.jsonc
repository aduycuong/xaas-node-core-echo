{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker per node version: node-<key with dashes>-v<version with dashes>.
  "name": "node-core-echo-v1-0-0",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Reached only through the runner's service binding.
  "workers_dev": false,
  "preview_urls": false
}
